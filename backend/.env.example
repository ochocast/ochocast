PG_PORT=5432
PG_HOST=localhost
PG_USERNAME=admin
PG_PASSWORD=admin
PG_DATABASE=ochocast-db
NODE_ENV=development

PORT=3001
WS_PORT=3001

AUTH_SERVER_URL=http://localhost:8080
AUTH_REALM=local-realm
AUTH_CLIENT_ID=nest-back
AUTH_SECRET=[INSERT YOUR SECRET HERE]

STOCK_SERVER_URL=http://localhost:9000
STOCK_CLIENT_ID=minioadmin
STOCK_SECRET=minioadmin
STOCK_MEDIA_BUCKET=media
STOCK_MINIATURE_BUCKET=miniature
STOCK_BRANDING_BUCKET=branding
STOCK_PROFILE_PICTURE_BUCKET=picture
STOCK_REGION=fr-par

RECORDING_VM_URL=http://localhost:8081

# Staging : vraie Scaleway Queue en HTTPS.
# Développement Docker : provider=local, endpoint=http://127.0.0.1:9324,
# URL=http://127.0.0.1:9324/000000000000/ochocast-local-ffmpeg,
# clés local/local (factices). Le pont FFmpeg démarre automatiquement à l'upload.
TRANSCODING_QUEUE_PROVIDER=scaleway
TRANSCODING_QUEUE_ENDPOINT=https://sqs.mnq.fr-par.scaleway.com
TRANSCODING_QUEUE_REGION=fr-par
TRANSCODING_QUEUE_URL=
TRANSCODING_QUEUE_ACCESS_KEY=
TRANSCODING_QUEUE_SECRET_KEY=
# Two different random secrets (at least 32 characters), shared with ffmpegServer.
TRANSCODING_DISPATCH_SECRET=
TRANSCODING_CALLBACK_SECRET=
# Must exceed the worker timeout plus callback time; see ffmpegServer/SERVERLESS.md.
TRANSCODING_LEASE_SECONDS=3600

# Optionnel : tester une vraie queue Scaleway depuis le backend local.
# Terraform dédié : ops-architecture-lab/terraform/ffmpeg-local-queue.
# Après son apply, npm run local:queue-config importe la configuration sans
# afficher les clés et active le pont automatique. Voir ffmpegServer/LOCAL_QUEUE_TEST.md.
# Sans trigger serverless. Non nécessaire avec TRANSCODING_QUEUE_PROVIDER=local.
# Si l'URL ci-dessous est renseignée et NODE_ENV=development, chaque upload
# déclenche automatiquement un traitement FFmpeg local.
# Identifiants séparés avec permission CanReceive pour la vraie queue.
# LOCAL_QUEUE_BRIDGE_QUEUE_URL=<même URL que TRANSCODING_QUEUE_URL>
# LOCAL_QUEUE_BRIDGE_ACCESS_KEY=<clé de réception Scaleway Queues>
# LOCAL_QUEUE_BRIDGE_SECRET_KEY=<secret de réception Scaleway Queues>
# LOCAL_QUEUE_BRIDGE_WORKER_URL=http://127.0.0.1:8081/

# Public base URL including the /api prefix, required behind a reverse proxy.
PUBLIC_API_URL=http://localhost:3001/api
