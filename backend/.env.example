PG_PORT=5432
PG_HOST=localhost
PG_USERNAME=admin
PG_PASSWORD=admin
PG_DATABASE=ochocast-db
NODE_ENV=development

PORT=3001
WS_PORT=3001

AUTH_SERVER_URL=http://localhost:8080
AUTH_REALM=local-realm
AUTH_CLIENT_ID=nest-back
AUTH_SECRET=[INSERT YOUR SECRET HERE]

STOCK_SERVER_URL=http://localhost:9000
STOCK_CLIENT_ID=minioadmin
STOCK_SECRET=minioadmin
STOCK_MEDIA_BUCKET=media
STOCK_MINIATURE_BUCKET=miniature
STOCK_BRANDING_BUCKET=branding
STOCK_PROFILE_PICTURE_BUCKET=picture
STOCK_REGION=fr-par

RECORDING_VM_URL=http://localhost:8081

# Transcodage FFmpeg : TRANSCODING_QUEUE_PROVIDER=disabled, local ou scaleway
# (valeur exacte, en minuscules). Voir ffmpegServer/SERVERLESS.md, section
# « Transcodage désactivé ».
# - disabled : recommandé en développement sans queue. Pas de HLS : la vidéo
#   est lue depuis son fichier source dès la fin de l'upload. Les variables de
#   queue ci-dessous sont ignorées (un seul WARN au démarrage).
# - local : queue Docker ElasticMQ (dev-tools/LOCAL_FFMPEG_QUEUE.md), exige
#   NODE_ENV=development ; endpoint=http://127.0.0.1:9324,
#   URL=http://127.0.0.1:9324/000000000000/ochocast-local-ffmpeg,
#   clés local/local (factices). Le pont FFmpeg démarre automatiquement à l'upload.
# - scaleway : vraie Scaleway Queue en HTTPS (staging),
#   endpoint=https://sqs.mnq.fr-par.scaleway.com, région fr-par ; toutes les
#   variables ci-dessous sont alors obligatoires.
# Absente ou vide, la variable vaut disabled, mais le démarrage échoue si une
# variable TRANSCODING_QUEUE_* ou TRANSCODING_DISPATCH_SECRET est renseignée.
TRANSCODING_QUEUE_PROVIDER=disabled
TRANSCODING_QUEUE_ENDPOINT=
TRANSCODING_QUEUE_REGION=
TRANSCODING_QUEUE_URL=
TRANSCODING_QUEUE_ACCESS_KEY=
TRANSCODING_QUEUE_SECRET_KEY=
# Two different random secrets (at least 32 characters), shared with ffmpegServer.
# When switching to disabled, keep TRANSCODING_CALLBACK_SECRET until in-flight
# jobs have drained: workers can still report their results.
TRANSCODING_DISPATCH_SECRET=
TRANSCODING_CALLBACK_SECRET=
# Must exceed the worker timeout plus callback time; see ffmpegServer/SERVERLESS.md.
TRANSCODING_LEASE_SECONDS=3600
# Recovery of jobs whose queue message was lost or dead-lettered. A job still
# pending this long after its last publication (keep it above the longest
# expected queue backlog, not just the visibility timeout), still failed this
# long after an error the backend marked retryable (its redeliveries may be
# dead-lettered; failures recorded by an older backend carry no marker and stay
# final), or still processing 10 minutes after its lease
# expired, is republished; its video stays pending meanwhile. Once it has been
# claimed TRANSCODING_MAX_ATTEMPTS times, the job and its video are marked
# failed instead, and any later delivery of its message is acknowledged without
# running FFmpeg again.
# TRANSCODING_REDISPATCH_AFTER_SECONDS=7200
# TRANSCODING_MAX_ATTEMPTS=10

# Optionnel : tester une vraie queue Scaleway depuis le backend local.
# Terraform dédié : ops-architecture-lab/terraform/ffmpeg-local-queue.
# Après son apply, npm run local:queue-config importe la configuration sans
# afficher les clés et active le pont automatique. Voir ffmpegServer/LOCAL_QUEUE_TEST.md.
# Sans trigger serverless. Non nécessaire avec TRANSCODING_QUEUE_PROVIDER=local.
# Si l'URL ci-dessous est renseignée et NODE_ENV=development, chaque upload
# déclenche automatiquement un traitement FFmpeg local.
# Identifiants séparés avec permission CanReceive pour la vraie queue.
# LOCAL_QUEUE_BRIDGE_QUEUE_URL=<même URL que TRANSCODING_QUEUE_URL>
# LOCAL_QUEUE_BRIDGE_ACCESS_KEY=<clé de réception Scaleway Queues>
# LOCAL_QUEUE_BRIDGE_SECRET_KEY=<secret de réception Scaleway Queues>
# LOCAL_QUEUE_BRIDGE_WORKER_URL=http://127.0.0.1:8081/

# Public base URL including the /api prefix, required behind a reverse proxy.
# Required (https) when TRANSCODING_QUEUE_PROVIDER=scaleway: HLS playlist URLs
# would otherwise be built as http:// behind the TLS-terminating ingress.
# NODE_ENV=development (local queue bridge, page and API over http) is exempt.
PUBLIC_API_URL=http://localhost:3001/api

# Keep admission aligned with the worker source limit (1 GiB in staging).
# A live recording above it is published from its source, without transcoding.
UPLOAD_MAX_BYTES=1073741824
UPLOAD_CHECKSUM_MODE=sha256
