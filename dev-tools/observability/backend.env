# Backend configuration for the observability POC (dependencies from this compose).
NODE_ENV=development
PORT=3001
PUBLIC_API_URL=http://localhost:3001/api

PG_HOST=localhost
PG_PORT=5433
PG_USERNAME=admin
PG_PASSWORD=admin
PG_DATABASE=ochocast-db

AUTH_SERVER_URL=http://localhost:8080
AUTH_REALM=local-realm
AUTH_CLIENT_ID=nest-back
AUTH_SECRET=this-is-a-local-keycloak-secret
KEYCLOAK_TOKEN_VALIDATION=OFFLINE

STOCK_SERVER_URL=http://localhost:4566
STOCK_CLIENT_ID=test
STOCK_SECRET=test
STOCK_REGION=eu-west-3
STOCK_FORCE_PATH_STYLE=true
STOCK_MEDIA_BUCKET=media
STOCK_MINIATURE_BUCKET=miniature
STOCK_BRANDING_BUCKET=branding
STOCK_PROFILE_PICTURE_BUCKET=picture

RABBITMQ_URL=amqp://admin:admin@localhost:5672
RABBITMQ_HOST=localhost
VIDEO_QUEUE_NAME=video-transcoding-queue
VIDEO_RESULT_QUEUE_NAME=video-transcoding-results

# Nothing listens there locally: recording calls fail on purpose (error path).
RECORDING_VM_URL=http://localhost:8091
CONTROL_PLANE_URL=http://localhost:8090

# --- Observability: standard OpenTelemetry variables only ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=ochocast-backend
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=local,service.version=poc
# Faster feedback than the 60 s default.
OTEL_METRIC_EXPORT_INTERVAL=10000
LOG_LEVEL=info
