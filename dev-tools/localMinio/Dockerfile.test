# MinIO no longer distributes this release as a public container image.
# Build the official, immutable source revision for disposable upload tests.
FROM golang:1.24.8-alpine AS builder
RUN apk add --no-cache git
RUN CGO_ENABLED=0 go install github.com/minio/minio@9e49d5e7a648f00e26f2246f4dc28e6b07f8c84a

FROM alpine:3.22
RUN apk add --no-cache ca-certificates
COPY --from=builder /go/bin/minio /usr/local/bin/minio
EXPOSE 9000
ENTRYPOINT ["minio"]
