{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":separateMajorReleases",
    ":combinePatchMinorReleases",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "packageRules": [
    {
      "matchPaths": ["backend/**"],
      "groupName": "backend"
    },
    {
      "matchPaths": ["frontend/**"],
      "groupName": "frontend"
    },
    {
      "matchPaths": ["sfuServer/**"],
      "groupName": "sfu-server"
    }
  ],
  "dependencyDashboard": true,
  "timezone": "Europe/Paris",
  "schedule": ["after 1am and before 7am every weekday", "every weekend"],
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": ["dependencies"]
}
