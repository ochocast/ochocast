# SFU server URL
SFU_BASE_URL=http://localhost:8090

# Backend URL for publishing recordings
BACKEND_PUBLIC_URL=http://localhost:3001

# Shared secret between backend and liveRecorder (REQUIRED — must match backend RECORDING_SHARED_SECRET).
# The backend signs each request with it (HMAC, see auth.go); it never travels.
RECORDING_SHARED_SECRET=[INSERT YOUR SECRET HERE]

# SFU this recorder records (REQUIRED; never taken from a request). On an SFU
# worker the bootstrap sets the local SFU; in local development, the worker.
RECORDER_SFU_URL=http://localhost:8091

# On SIGTERM, how long the recorder waits for its uploads before exiting
# (seconds, default 600). The container stop timeout must be longer.
# RECORDER_SHUTDOWN_GRACE_SECONDS=600
