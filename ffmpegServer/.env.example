# Minio S3 Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
STOCK_MEDIA_BUCKET=media
STOCK_MINIATURE_BUCKET=miniature

# HTTP container invoked by the Scaleway Queues trigger.
PORT=8080
TRANSCODING_BACKEND_URL=http://localhost:3001/api
# Docker Compose utilise host.docker.internal par défaut ; optionnel :
# LOCAL_TRANSCODING_BACKEND_URL=http://host.docker.internal:3001/api
TRANSCODING_DISPATCH_SECRET=
TRANSCODING_CALLBACK_SECRET=
TRANSCODING_JOB_TIMEOUT_MS=3000000
TRANSCODING_MAX_SOURCE_BYTES=5368709120
# In Docker this defaults to /work/transcoding (ephemeral disk, not RAM-backed /tmp).
# TRANSCODING_WORK_DIR=/work/transcoding
FFMPEG_THREADS=2

# HLS Transcoding Configuration
HLS_RESOLUTIONS=360p,480p,720p
HLS_SEGMENT_DURATION=5
