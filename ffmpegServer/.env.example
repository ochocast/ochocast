# Minio S3 Configuration
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
STOCK_MEDIA_BUCKET=media
STOCK_MINIATURE_BUCKET=miniature

# HTTP container invoked by the Scaleway Queues trigger.
# transcode (default) or merge: the same image is deployed twice, each
# deployment behind its own queue and trigger (US-3 merges).
FFMPEG_WORKER_MODE=transcode
PORT=8080
TRANSCODING_BACKEND_URL=http://localhost:3001/api
# Docker Compose utilise host.docker.internal par défaut ; optionnel :
# LOCAL_TRANSCODING_BACKEND_URL=http://host.docker.internal:3001/api
TRANSCODING_DISPATCH_SECRET=
TRANSCODING_CALLBACK_SECRET=
TRANSCODING_JOB_TIMEOUT_MS=3000000
# Largest source (transcode) or total of a montage's segments (merge). On the
# merge deployment, raise it: segments reach 8 GiB (about 2 GB per hour of live
# at 4.5 Mbit/s), the whole montage is re-encoded within
# TRANSCODING_JOB_TIMEOUT_MS (55 min at most) and the disk needs about twice
# the total. Above it a montage fails at once; see SERVERLESS.md
# "Dimensionner le déploiement de fusion".
TRANSCODING_MAX_SOURCE_BYTES=5368709120
# Longer videos are not encoded: their final miniature and subtitle are written,
# then the backend plays the source instead of HLS if browsers can (mp4, m4v,
# webm, mov in H.264/VP8/VP9/AV1 8-bit 4:2:0); otherwise the video fails.
# Default 1200 s, sized for 2 vCPU. 3600 s is the estimate for the 6 vCPU staging
# worker; see SERVERLESS.md "Performance et coût" before raising it.
TRANSCODING_MAX_DURATION_SECONDS=1200
# In Docker this defaults to /work/transcoding (ephemeral disk, not RAM-backed /tmp).
# TRANSCODING_WORK_DIR=/work/transcoding
# Threads of EACH x264 encoder. One FFmpeg process decodes the source once and
# runs three encoders (360p, 480p, 720p): 3 x FFMPEG_THREADS encoding threads,
# plus FFmpeg's automatic decoding/scaling threads. 4 on 6 vCPU (estimate).
# In merge mode it caps the single encoder of each normalization: leave it
# unset there so x264 uses every vCPU.
FFMPEG_THREADS=2
# HLS files uploaded in parallel (default 8); master.m3u8 is uploaded last.
# TRANSCODING_UPLOAD_CONCURRENCY=8

# HLS Transcoding Configuration
HLS_RESOLUTIONS=360p,480p,720p
HLS_SEGMENT_DURATION=5
