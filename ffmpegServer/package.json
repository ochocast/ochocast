{
  "name": "ffmpeg-transcoding-service",
  "version": "1.0.0",
  "description": "Scaleway Queues-triggered HTTP FFmpeg transcoder",
  "main": "dist/http-worker.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/http-worker.js",
    "start:http": "node dist/http-worker.js",
    "dev": "ts-node src/http-worker.ts",
    "dev:http": "ts-node src/http-worker.ts",
    "test": "node --test --require ts-node/register tests/*.test.ts",
    "test:connection": "ts-node src/test-connection.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1031.0",
    "@aws-sdk/lib-storage": "^3.1031.0",
    "sharp": "^0.35.4",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2"
  }
}
