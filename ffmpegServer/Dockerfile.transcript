# GPU build: docker build --target gpu -f Dockerfile.transcript .
FROM nvidia/cuda:12.3.2-cudnn9-runtime-ubuntu22.04 AS gpu
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY transcript/requirements.txt .
RUN pip3 install --no-cache-dir -r requirements.txt
COPY transcript/server.py .
ENV NODE_ENV=production WHISPER_DEVICE=cuda WHISPER_COMPUTE_TYPE=float16 LOCAL_WHISPER_MODEL=small
EXPOSE 8080
CMD ["python3", "server.py"]

# CPU/local build is the default and works on amd64 and arm64.
FROM python:3.11-slim AS cpu
WORKDIR /app
COPY transcript/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY transcript/server.py .
ENV NODE_ENV=production WHISPER_DEVICE=cpu WHISPER_COMPUTE_TYPE=int8 LOCAL_WHISPER_MODEL=small
EXPOSE 8080
CMD ["python3", "server.py"]
